# Environment and build detritus.
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# The API key.
.env

# Somebody else's bytes, and re-fetchable: snapshots hold whole article texts,
# JATS XML, supplementary files and figure images; the cache holds the HTTP
# responses they came from. data/curated/ IS tracked -- it is model output we
# paid for, and the ledger is the denominator.
data/raw/
data/cache/

# Raw Claude responses. Paid for, so never evicted, but not tracked: thinking
# can paraphrase article text at length, which puts it on the data/raw/ side of
# the licence line.
data/responses/

# Held by any command that writes, so two runs never interleave.
data/.lock

# The release; CI builds and deploys its own from a tag.
_site/

# Reference papers, kept locally for reading.
docs/refs/
