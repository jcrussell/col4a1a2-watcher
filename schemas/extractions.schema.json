{
  "$defs": {
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "FunctionalAssay": {
      "properties": {
        "assay_type": {
          "description": "e.g. collagen IV secretion, intracellular retention, ER stress, splicing minigene, mouse model",
          "title": "Assay Type",
          "type": "string"
        },
        "evidence_quote": {
          "description": "Verbatim sentence from the paper supporting the result",
          "title": "Evidence Quote",
          "type": "string"
        },
        "result": {
          "description": "What the assay showed for this variant",
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "assay_type",
        "result",
        "evidence_quote"
      ],
      "title": "FunctionalAssay",
      "type": "object"
    },
    "Gene": {
      "enum": [
        "COL4A1",
        "COL4A2"
      ],
      "title": "Gene",
      "type": "string"
    },
    "Grounding": {
      "additionalProperties": false,
      "properties": {
        "figure_sourced": {
          "items": {
            "type": "string"
          },
          "title": "Figure Sourced",
          "type": "array"
        },
        "grounded": {
          "title": "Grounded",
          "type": "integer"
        },
        "low_confidence": {
          "items": {},
          "title": "Low Confidence",
          "type": "array"
        },
        "model_transcribed_only": {
          "items": {
            "type": "string"
          },
          "title": "Model Transcribed Only",
          "type": "array"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "overconfident_transcribed": {
          "items": {
            "type": "string"
          },
          "title": "Overconfident Transcribed",
          "type": "array"
        },
        "quote_regions": {
          "items": {},
          "title": "Quote Regions",
          "type": "array"
        },
        "region_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Region Counts",
          "type": "object"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "ungrounded": {
          "items": {},
          "title": "Ungrounded",
          "type": "array"
        }
      },
      "required": [
        "total",
        "grounded"
      ],
      "title": "Grounding",
      "type": "object"
    },
    "InheritanceCounts": {
      "properties": {
        "de_novo_assumed": {
          "description": "Probands called de novo without described parental testing",
          "title": "De Novo Assumed",
          "type": "integer"
        },
        "de_novo_confirmed": {
          "description": "Probands whose parents were both tested negative",
          "title": "De Novo Confirmed",
          "type": "integer"
        },
        "inherited": {
          "description": "Probands with a carrier parent",
          "title": "Inherited",
          "type": "integer"
        },
        "unknown": {
          "description": "Probands with no inheritance information",
          "title": "Unknown",
          "type": "integer"
        }
      },
      "required": [
        "de_novo_confirmed",
        "de_novo_assumed",
        "inherited",
        "unknown"
      ],
      "title": "InheritanceCounts",
      "type": "object"
    },
    "PaperExtraction": {
      "properties": {
        "extraction_notes": {
          "default": "",
          "description": "Anything the reviewer should know: data referred to but not provided, supplementary rows filtered out, an illegible figure transcription, numbering issues",
          "title": "Extraction Notes",
          "type": "string"
        },
        "has_variant_level_data": {
          "description": "True if the paper reports specific COL4A1/COL4A2 variants in specific individuals",
          "title": "Has Variant Level Data",
          "type": "boolean"
        },
        "input_was_abstract_only": {
          "description": "True if only the title and abstract were available",
          "title": "Input Was Abstract Only",
          "type": "boolean"
        },
        "paper_type": {
          "$ref": "#/$defs/PaperType"
        },
        "pmcid": {
          "default": "",
          "title": "Pmcid",
          "type": "string"
        },
        "pmid": {
          "title": "Pmid",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/VariantEvidence"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "pmid",
        "paper_type",
        "input_was_abstract_only",
        "has_variant_level_data"
      ],
      "title": "PaperExtraction",
      "type": "object"
    },
    "PaperType": {
      "enum": [
        "case_report",
        "case_series",
        "cohort",
        "review",
        "functional",
        "other"
      ],
      "title": "PaperType",
      "type": "string"
    },
    "PhenotypeStatus": {
      "enum": [
        "present",
        "absent_on_exam",
        "not_assessed"
      ],
      "title": "PhenotypeStatus",
      "type": "string"
    },
    "Phenotypes": {
      "properties": {
        "cerebrovascular": {
          "$ref": "#/$defs/PhenotypeStatus",
          "description": "Porencephaly, intracerebral or intraventricular haemorrhage, schizencephaly, stroke, perinatal brain injury"
        },
        "details": {
          "default": "",
          "description": "Free-text summary of the phenotype(s) as reported, including age at onset if stated",
          "title": "Details",
          "type": "string"
        },
        "muscle": {
          "$ref": "#/$defs/PhenotypeStatus",
          "description": "Cramps, elevated CK, myopathy"
        },
        "ocular": {
          "$ref": "#/$defs/PhenotypeStatus",
          "description": "Cataract, anterior segment dysgenesis, Axenfeld-Rieger, retinal arterial tortuosity"
        },
        "other": {
          "$ref": "#/$defs/PhenotypeStatus",
          "description": "Any other organ-system finding; describe in details"
        },
        "renal_hanac": {
          "$ref": "#/$defs/PhenotypeStatus",
          "description": "Hematuria, cysts, nephropathy, HANAC features"
        },
        "small_vessel": {
          "$ref": "#/$defs/PhenotypeStatus",
          "description": "Leukoencephalopathy, microbleeds, lacunes, PADMAL, white-matter disease on imaging"
        }
      },
      "required": [
        "cerebrovascular",
        "small_vessel",
        "renal_hanac",
        "ocular",
        "muscle",
        "other"
      ],
      "title": "Phenotypes",
      "type": "object"
    },
    "Segregation": {
      "properties": {
        "affected_carriers": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Relatives who carry the variant and are affected, excluding probands; null if not stated",
          "title": "Affected Carriers"
        },
        "non_carrier_affected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Affected relatives shown not to carry the variant; null if not stated",
          "title": "Non Carrier Affected"
        },
        "unaffected_carriers": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Relatives who carry the variant and are reported unaffected; null if not stated",
          "title": "Unaffected Carriers"
        }
      },
      "title": "Segregation",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cache_read": {
          "default": 0,
          "title": "Cache Read",
          "type": "integer"
        },
        "cache_write": {
          "default": 0,
          "title": "Cache Write",
          "type": "integer"
        },
        "input": {
          "default": 0,
          "title": "Input",
          "type": "integer"
        },
        "output": {
          "default": 0,
          "title": "Output",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "VariantEvidence": {
      "properties": {
        "as_written": {
          "description": "The variant exactly as written in the paper (first occurrence)",
          "title": "As Written",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "description": "Your confidence that the counts and phenotype statuses are correct"
        },
        "evidence_quotes": {
          "description": "2-5 verbatim sentences from the paper that support the counts and phenotypes above",
          "items": {
            "type": "string"
          },
          "title": "Evidence Quotes",
          "type": "array"
        },
        "functional_assays": {
          "items": {
            "$ref": "#/$defs/FunctionalAssay"
          },
          "title": "Functional Assays",
          "type": "array"
        },
        "gene": {
          "$ref": "#/$defs/Gene"
        },
        "genome_build_if_stated": {
          "default": "",
          "description": "GRCh37/hg19 or GRCh38/hg38 if stated",
          "title": "Genome Build If Stated",
          "type": "string"
        },
        "hgvs_c": {
          "default": "",
          "description": "Coding HGVS if given or unambiguously derivable, e.g. c.1537G>A; empty if not",
          "title": "Hgvs C",
          "type": "string"
        },
        "hgvs_p": {
          "default": "",
          "description": "Protein HGVS if given, e.g. p.Gly513Ser; empty if not",
          "title": "Hgvs P",
          "type": "string"
        },
        "inheritance": {
          "$ref": "#/$defs/InheritanceCounts",
          "description": "Proband counts by inheritance mode; must sum to n_probands"
        },
        "n_families": {
          "description": "Number of families reported with this variant in THIS paper",
          "title": "N Families",
          "type": "integer"
        },
        "n_probands": {
          "description": "Number of unrelated probands reported with this variant in THIS paper",
          "title": "N Probands",
          "type": "integer"
        },
        "n_total_carriers": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "All reported carriers including relatives; null if not stated",
          "title": "N Total Carriers"
        },
        "notes": {
          "default": "",
          "description": "Ambiguities, e.g. numbering convention unclear, table only, abstract only",
          "title": "Notes",
          "type": "string"
        },
        "phenotypes": {
          "$ref": "#/$defs/Phenotypes"
        },
        "prior_report_pmid": {
          "default": "",
          "description": "PMID of the prior report if cited",
          "title": "Prior Report Pmid",
          "type": "string"
        },
        "prior_report_reason": {
          "default": "",
          "description": "Why you think it is the same family",
          "title": "Prior Report Reason",
          "type": "string"
        },
        "reported_classification": {
          "default": "",
          "description": "The authors' own classification (pathogenic, likely pathogenic, VUS) if stated",
          "title": "Reported Classification",
          "type": "string"
        },
        "same_family_as_prior_report": {
          "description": "True if the paper indicates this family or proband was reported before",
          "title": "Same Family As Prior Report",
          "type": "boolean"
        },
        "segregation": {
          "$ref": "#/$defs/Segregation"
        },
        "transcript_if_stated": {
          "default": "",
          "description": "Reference transcript if the paper states it, e.g. NM_001845.6",
          "title": "Transcript If Stated",
          "type": "string"
        },
        "variant_type": {
          "description": "missense_glycine, missense_other, splice, nonsense, frameshift, inframe_indel, intronic, utr, deletion_cnv, other",
          "title": "Variant Type",
          "type": "string"
        }
      },
      "required": [
        "gene",
        "as_written",
        "variant_type",
        "n_probands",
        "n_families",
        "inheritance",
        "segregation",
        "phenotypes",
        "same_family_as_prior_report",
        "evidence_quotes",
        "confidence"
      ],
      "title": "VariantEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One row of extractions.jsonl. Either a result or a recorded failure.",
  "properties": {
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "extraction": {
      "anyOf": [
        {
          "$ref": "#/$defs/PaperExtraction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "grounding": {
      "anyOf": [
        {
          "$ref": "#/$defs/Grounding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "pmcid": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pmcid"
    },
    "pmid": {
      "title": "Pmid",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Version"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "text_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Sha256"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "pmid",
    "prompt_version"
  ],
  "title": "ExtractionRow",
  "type": "object"
}
