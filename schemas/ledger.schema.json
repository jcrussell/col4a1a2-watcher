        },
        "pubtator_gene_linked_variant": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pubtator Gene Linked Variant"
        },
        "pubtator_gene_variant": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pubtator Gene Variant"
        },
        "pubtator_linked_hgvs": {
          "items": {
            "type": "string"
          },
          "title": "Pubtator Linked Hgvs",
          "type": "array"
        },
        "pubtator_search_hit": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pubtator Search Hit"
