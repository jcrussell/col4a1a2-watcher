            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Upheld"
        }
      },
      "title": "ChallengeSummary",
      "type": "object"
    },
    "TriageVerdict": {
      "additionalProperties": false,
      "description": "Both forms of the triage verdict.\n\n`papers.jsonl` stores all eleven fields; the ledger stores the four that\ndescribe the decision rather than the signals behind it. One model with\noptional fields covers both, and forbids a fifth spelling of either.",
      "properties": {
        "clinical_keyword": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clinical Keyword"
        },
        "keep": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keep"
        },
        "keyword_keep": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyword Keep"
        },
        "llm_keep": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Keep"
        },
        "llm_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
